# ==============================================================================
# GlassFolio — Environment Configuration Template
# ==============================================================================
# Copiez ce fichier sous le nom '.env' ou '.env.local' pour vos variables locales :
#   cp .env.example .env
# Ne commitez JAMAIS votre fichier .env ou vos secrets réels sur GitHub.
# ==============================================================================

# --- Notion API (Synchronisation des Tâches & Sprints) ---
# Votre clé d'intégration interne Notion (commence par 'secret_' ou 'ntn_') :
NOTION_API_KEY=your_notion_integration_secret_here

# ID de la base de données Notion "Tâches" (par défaut déjà préconfiguré pour GlassFolio) :
NOTION_TASKS_DB_ID=73594813-9137-82eb-887a-8157fd353c7a

# --- Obsidian MCP & Documentation locale ---
# Chemin absolu vers votre coffre Obsidian local (dossier GlassFolio) :
BRAIN_PATH=/Users/damien/Developpement/brain/GlassFolio

# --- Backend / Cloud (Futur déploiement Azure ou InstantDB) ---
# INSTANT_DB_APP_ID=your_instant_db_app_id
# AZURE_API_ENDPOINT=https://your-api.azurewebsites.net
