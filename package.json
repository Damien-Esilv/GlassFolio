{
  "name": "glassfolio",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:demo": "node scripts/dev-server.mjs --demo",
    "dev:online": "node scripts/dev-server.mjs --online",
    "dev:cloud": "node scripts/dev-server.mjs --online",
    "dev:local": "node scripts/dev-server.mjs",
    "dev:app": "VITE_DEPLOYMENT_MODE=local VITE_APP_TARGET=app vite",
    "dev:showcase": "VITE_DEPLOYMENT_MODE=cloud VITE_APP_TARGET=showcase vite",
    "build": "vite build",
    "build:local": "VITE_DEPLOYMENT_MODE=local VITE_APP_TARGET=app vite build",
    "build:app": "VITE_DEPLOYMENT_MODE=cloud VITE_APP_TARGET=app vite build",
    "build:showcase": "VITE_DEPLOYMENT_MODE=cloud VITE_APP_TARGET=showcase vite build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:shard": "VITEST_PARTIAL_COVERAGE=1 vitest run --coverage --reporter=blob",
    "test:coverage:merge": "vitest run --merge-reports=.vitest-reports --coverage",
    "test:security": "vitest run tests/unit/services/security tests/unit/services/ai/tools/securityTools.test.ts",
    "test:property": "vitest run tests/property",
    "test:contracts": "vitest run tests/unit/contracts",
    "test:e2e": "playwright test --project=chromium-core",
    "test:e2e:tier2": "playwright test --project=chromium-core --project=chromium-tier2",
    "test:e2e:ui": "playwright test --ui",
    "test:sql": "node scripts/test-sql.mjs",
    "check:types": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:theming": "vitest run tests/unit/standards tests/unit/components/theming",
    "check:supply-chain": "node scripts/verify-supply-chain-sha.mjs",
    "security:headers": "node scripts/sync-vercel-headers.mjs",
    "check:headers": "node scripts/sync-vercel-headers.mjs --check",
    "check:standards": "node scripts/verify-supply-chain-sha.mjs && node scripts/sync-vercel-headers.mjs --check && node scripts/check-standards.mjs && vitest run tests/unit/standards tests/unit/components/theming tests/unit/services/security/architectureInvariants.test.ts --reporter=verbose",
    "check:mcp": "node --check mcp-server/index.mjs",
    "db:purge-test-accounts": "node scripts/purge-test-accounts.mjs",
    "deploy:emails": "node scripts/deploy-email-templates.mjs",
    "deploy:emails:apply": "node scripts/deploy-email-templates.mjs --apply",
    "deploy:turnstile": "node scripts/deploy-turnstile-config.mjs",
    "deploy:turnstile:apply": "node scripts/deploy-turnstile-config.mjs --apply",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "prepare": "node -e \"const fs=require('fs'); try { if (fs.existsSync('.git') && fs.existsSync('.git/hooks')) { fs.copyFileSync('scripts/pre-commit.sh', '.git/hooks/pre-commit'); fs.chmodSync('.git/hooks/pre-commit', 0o755); } } catch (e) {}\"",
    "precommit:check": "node scripts/pre-commit-check.mjs",
    "notion:sync": "node scripts/notion-sync.mjs",
    "docker:up": "node scripts/docker-guard.mjs && docker compose --env-file docker/docker.env up -d --build && node scripts/docker-ready.mjs",
    "docker:down": "docker compose --env-file docker/docker.env down",
    "docker:logs": "docker compose --env-file docker/docker.env logs -f glassfolio",
    "docker:smoke": "node scripts/smoke-docker.mjs",
    "mcp": "node mcp-server/index.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "ollama:proxy": "node scripts/ollama-proxy.mjs",
    "ollama:tunnel": "cloudflared tunnel --url http://localhost:11434",
    "mcp:catalog": "UPDATE_MCP_CATALOG=1 vitest run tests/unit/mcp/catalog.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "i18next": "^25.8.4",
    "lucide-react": "^0.554.0",
    "motion": "14.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.4.1",
    "thinking-orbs": "^0.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "minimatch": "^11.0.3"
  }
}
