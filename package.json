{
  "name": "copy-of-glassfolio-working",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_APP_TARGET=unified vite",
    "dev:app": "VITE_DEPLOYMENT_MODE=local VITE_APP_TARGET=app vite",
    "dev:showcase": "VITE_DEPLOYMENT_MODE=cloud VITE_APP_TARGET=showcase vite",
    "build": "vite build",
    "build:local": "VITE_DEPLOYMENT_MODE=local VITE_APP_TARGET=app vite build",
    "build:app": "VITE_DEPLOYMENT_MODE=cloud VITE_APP_TARGET=app vite build",
    "build:showcase": "VITE_DEPLOYMENT_MODE=cloud VITE_APP_TARGET=showcase vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run tests/unit/services/security tests/unit/services/ai/tools/securityTools.test.ts",
    "check:types": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:theming": "vitest run tests/unit/standards tests/unit/components/theming",
    "check:supply-chain": "node scripts/verify-supply-chain-sha.mjs",
    "check:standards": "node scripts/verify-supply-chain-sha.mjs && node scripts/check-standards.mjs && vitest run tests/unit/standards tests/unit/components/theming tests/unit/services/security/architectureInvariants.test.ts --reporter=verbose",
    "check:mcp": "node --check mcp-server/index.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "prepare": "node -e \"const fs=require('fs'); try { if (fs.existsSync('.git') && fs.existsSync('.git/hooks')) { fs.copyFileSync('scripts/pre-commit.sh', '.git/hooks/pre-commit'); fs.chmodSync('.git/hooks/pre-commit', 0o755); } } catch (e) {}\"",
    "precommit:check": "node scripts/pre-commit-check.mjs",
    "notion:sync": "node scripts/notion-sync.mjs",
    "mcp": "node mcp-server/index.mjs",
    "ollama:proxy": "node scripts/ollama-proxy.mjs",
    "ollama:tunnel": "cloudflared tunnel --url http://localhost:11434"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "i18next": "^25.8.4",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.4.1",
    "thinking-orbs": "^0.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  }
}
