{
  "buildCommand": "npm run build:vercel",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "app.glassfolio.dev"
        }
      ],
      "destination": "/app-shell.html"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "dev-app.glassfolio.dev"
        }
      ],
      "destination": "/app-shell.html"
    },
    {
      "source": "/:lang(en|fr)",
      "destination": "/_p/:lang/index.html"
    },
    {
      "source": "/:lang(en|fr)/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "destination": "/_p/:lang/:page.html"
    },
    {
      "source": "/",
      "destination": "/_p/en/index.html"
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "destination": "/_p/en/:page.html"
    },
    {
      "source": "/(login|signup|forgot-password|reset-password|dashboard|portfolio|positions|transactions|analytics|tax|reports|goals|alerts|notifications|settings|progress|import|import-history)(/.*)?",
      "destination": "/app-shell.html"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "redirects": [
    {
      "source": "/welcome",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/welcome/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "destination": "/:page",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "fr"
        }
      ],
      "destination": "/fr",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        },
        {
          "type": "cookie",
          "key": "gf_public_lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        },
        {
          "type": "cookie",
          "key": "gf_public_lang",
          "value": "fr"
        }
      ],
      "destination": "/fr",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        },
        {
          "type": "header",
          "key": "accept-language",
          "value": "^fr.*"
        }
      ],
      "destination": "/fr",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        }
      ],
      "destination": "/en",
      "statusCode": 307
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/:page",
      "statusCode": 307
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "fr"
        }
      ],
      "destination": "/fr/:page",
      "statusCode": 307
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        },
        {
          "type": "cookie",
          "key": "gf_public_lang",
          "value": "fr"
        }
      ],
      "destination": "/fr/:page",
      "statusCode": 307
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "glassfolio.dev"
        }
      ],
      "destination": "/en/:page",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "fr"
        }
      ],
      "destination": "/fr",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        },
        {
          "type": "cookie",
          "key": "gf_public_lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        },
        {
          "type": "cookie",
          "key": "gf_public_lang",
          "value": "fr"
        }
      ],
      "destination": "/fr",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        },
        {
          "type": "header",
          "key": "accept-language",
          "value": "^fr.*"
        }
      ],
      "destination": "/fr",
      "statusCode": 307
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        }
      ],
      "destination": "/en",
      "statusCode": 307
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/:page",
      "statusCode": 307
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        },
        {
          "type": "query",
          "key": "lang",
          "value": "fr"
        }
      ],
      "destination": "/fr/:page",
      "statusCode": 307
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        },
        {
          "type": "cookie",
          "key": "gf_public_lang",
          "value": "fr"
        }
      ],
      "destination": "/fr/:page",
      "statusCode": 307
    },
    {
      "source": "/:page(self-host|about|roadmap|changelog|legal|privacy|terms|cookies|accessibility)",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        }
      ],
      "destination": "/en/:page",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://query1.finance.yahoo.com https://challenges.cloudflare.com https://www.googleapis.com https://api.openai.com https://api.anthropic.com https://api.groq.com https://openrouter.ai https://generativelanguage.googleapis.com https://api.coingecko.com http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types glassfolio-qr default"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.glassfolio.dev"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/_p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dev-app.glassfolio.dev"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dev-showcase.glassfolio.dev"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
