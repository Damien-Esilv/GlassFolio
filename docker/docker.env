# Defaults for `docker compose` (used by the npm run docker:* scripts via --env-file).
# Deliberately separate from the repository .env, which holds app/cloud secrets that
# the self-hosted container must never see or be blocked by.
GLASSFOLIO_PORT=3000
GLASSFOLIO_BIND=127.0.0.1
# GLASSFOLIO_ALLOWED_HOSTS=glassfolio.example.com   # domain names allowed to reach the vault API
# GLASSFOLIO_CSP_CONNECT_SRC=https://ollama.example.com   # extra origins the page may call (remote Ollama...)
# Network exposure requires a token, set in your shell (never in this file):
#   GLASSFOLIO_BIND=0.0.0.0 GLASSFOLIO_ACCESS_TOKEN=$(openssl rand -hex 16) npm run docker:up
# GLASSFOLIO_DATA=/path/to/folder                     # host folder instead of the named volume
